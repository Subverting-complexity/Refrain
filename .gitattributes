# Normalize line endings to LF on commit, checkout as OS-native
* text=auto

# Force LF for source files (consistent across Windows/macOS/Linux)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.aac binary
*.m4a binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
