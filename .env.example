# Copy this file to `.env` (gitignored) and fill in the real value.
#
# Personal Expo access token for the user that owns the `subvertingcomplexity`
# account. Create one at: https://expo.dev/accounts/subvertingcomplexity → Access tokens
# (log in as your PERSONAL user, not the work account).
#
# When set, EAS CLI uses this token instead of your global `eas login` session,
# so this repo always talks to `subvertingcomplexity` while other repos keep
# using your work login. Never commit the real token.
EXPO_TOKEN=

# Apple Developer account email. Deliberately NOT in eas.json, because this
# repository is public and this is a personal address. EAS reads EXPO_APPLE_ID
# when it prompts for Apple credentials during a build or submit; fastlane
# reads APPLE_ID (see fastlane/Appfile).
EXPO_APPLE_ID=
APPLE_ID=

# App Store Connect API key, for the iOS store listing push. A third identity,
# separate from both the Expo token and the Apple ID above: App Store Connect →
# Users and Access → Integrations, with the App Manager role. The .p8 private
# key downloads once and only once.
#
# A `.env` file holds one KEY=VALUE per line and cannot carry the newlines a PEM
# block needs, so point ASC_KEY_PATH at the downloaded `.p8` file instead of
# pasting its contents. `*.p8` is gitignored, so keeping it in the repo root is
# safe. ASC_KEY_CONTENT is the alternative for a shell that can export a
# multi-line string (see fastlane/PUBLISHING.md); set one or the other.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
ASC_KEY_CONTENT=

# Google Play service-account JSON, for the Android store listing push. A path,
# not the JSON itself. Leave it blank to use ./pc-api-key.json, which is what
# eas.json's submit config and the fastlane lane both fall back to. The file is
# gitignored; never commit it.
SUPPLY_JSON_KEY=
