# Copy this file to `.env` (gitignored) and fill in the real value.
#
# Personal Expo access token for the user that owns the `subvertingcomplexity`
# account. Create one at: https://expo.dev/accounts/subvertingcomplexity → Access tokens
# (log in as your PERSONAL user, not the work account).
#
# When set, EAS CLI uses this token instead of your global `eas login` session,
# so this repo always talks to `subvertingcomplexity` while other repos keep
# using your work login. Never commit the real token.
EXPO_TOKEN=

# Apple Developer account email. Deliberately NOT in eas.json, because this
# repository is public and this is a personal address. EAS reads EXPO_APPLE_ID
# when it prompts for Apple credentials during a build or submit; fastlane
# reads APPLE_ID (see fastlane/Appfile).
EXPO_APPLE_ID=
APPLE_ID=
