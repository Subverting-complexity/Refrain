node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
*.log
.DS_Store
coverage/

# Local secrets — Expo auth token (per-user, never commit). .env.example is tracked.
.env
.env.local
.direnv/

# Store-publishing secrets — NEVER commit these.
pc-api-key.json          # Google Play service-account JSON
*.p8                     # App Store Connect API private key
fastlane/.env*
fastlane/report.xml
fastlane/README.md       # auto-generated by `fastlane docs`
**/.fastlane/

# Local store-build logs (tools/ps/)
tools/ps/ios-build-log.json
tools/ps/android-build-log.json

# github-workflow plugin per-session scratch (claim refs, plan notes)
.claude/plan.md
.claude/claim-issue-*.sha
.claude/claim-pr-*.sha
.claude/issue-fields-cache.json

# graphify — generated artifacts (rebuild via `graphify . --update`, ~10s, 0 tokens)
graphify-out/graph.json
graphify-out/graph.html
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_analysis.json
# Keyed by absolute paths + mtimes, so graphify rewrites them on every run
# (including the per-session Stop hook). In a worktree-per-session setup that
# makes them dirty on essentially every run with nothing of value lost.
graphify-out/manifest.json
graphify-out/cache/stat-index.json
# Per-file AST caches are keyed by absolute worktree paths, so they are
# machine-/worktree-specific and rewritten on every run — never track new ones.
graphify-out/cache/ast/

# fallow — local analysis cache
.fallow/

# Visual Studio
.vs/

