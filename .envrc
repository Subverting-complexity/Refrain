# Auto-loaded by direnv when you cd into this repo.
# Pulls EXPO_TOKEN (and any other vars) from the gitignored .env file so EAS
# authenticates as the PERSONAL Expo user that owns `subvertingcomplexity`,
# overriding any global `eas login` session (e.g. your work account).
#
# One-time setup:
#   1. cp .env.example .env   (then paste your personal access token into .env)
#   2. direnv allow
# Leaving the directory unsets the vars automatically.

if [ -f .env ]; then
  dotenv .env
else
  echo "direnv: .env not found — copy .env.example to .env and add your EXPO_TOKEN" >&2
fi
