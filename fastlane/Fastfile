# Refrain — fastlane lanes
#
# This project builds and submits its BINARIES with EAS (see eas.json). These
# lanes handle the part EAS does not: the store *listing* — metadata, keywords,
# screenshots, and the privacy/data-safety declarations. That is why every lane
# skips the binary upload.
#
# Prerequisites (see fastlane/PUBLISHING.md for the full checklist):
#   iOS      ASC_KEY_ID, ASC_ISSUER_ID, and the private key as either
#            ASC_KEY_CONTENT (raw .p8 contents) or ASC_KEY_PATH (path to it)
#   Android  SUPPLY_JSON_KEY -> path to the Play service-account JSON
#
# ASC_KEY_PATH exists because a .env file holds one KEY=VALUE per line and
# cannot carry the newlines a PEM block needs. Exporting ASC_KEY_CONTENT from a
# shell still works; the Windows deploy script loads .env, so it uses the path.
#
# Usage:
#   bundle exec fastlane ios listing                 # push metadata + screenshots
#   bundle exec fastlane ios listing submit:true     # also submit the current build for review
#   bundle exec fastlane android listing             # push Play listing metadata + screenshots
#   bundle exec fastlane ios refresh_privacy_template # capture exact Apple privacy enums once

APP_ID = "com.subvertingcomplexity.refrain"

# The App Store Connect API key, however this machine happens to hold it.
#
# Plain Ruby rather than a lane, so both lanes below can call it and neither
# has to repeat the two spellings of the private key. ASC_KEY_PATH wins when it
# is set, because the machine that has a file path is the one whose credentials
# came out of a .env; ASC_KEY_CONTENT is the shell-export route and is still
# what fastlane/PUBLISHING.md documents for bash.
def asc_key_options
  options = {
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
  }
  path = ENV["ASC_KEY_PATH"]
  if path && !path.strip.empty?
    options[:key_filepath] = path
  else
    options[:key_content] = ENV.fetch("ASC_KEY_CONTENT") # raw .p8, incl. BEGIN/END lines
  end
  options
end

# ---------------------------------------------------------------------------
platform :ios do
  desc "Upload App Store listing: metadata and screenshots"
  #
  # The privacy nutrition label is NOT pushed here, and that is not an
  # oversight. upload_app_privacy_details_to_app_store does not support App
  # Store Connect API keys: its first line is
  #
  #   Spaceship::ConnectAPI.login(params[:username], use_portal: false, use_tunes: true, ...)
  #
  # which is an Apple ID and password, and it has no token path at all. In this
  # lane that meant the whole listing push died at its first action, waiting on
  # a password prompt, before a single field of metadata was uploaded. Every
  # other part of the listing authenticates with the key perfectly well, so the
  # one action that cannot is the one that moved out. See the privacy lane.
  lane :listing do |options|
    api_key = app_store_connect_api_key(asc_key_options)

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,          # binary comes from EAS
      skip_app_version_update: false,
      submit_for_review: options[:submit] == true,
      automatic_release: false,
      force: true,                       # no interactive HTML preview
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      overwrite_screenshots: true,
    )
  end

  desc "Push the privacy nutrition label. Needs an interactive Apple ID sign-in, not the API key"
  #
  # Split out of the listing lane because it cannot run the way the rest of the
  # release runs. Both privacy actions sign in with an Apple ID and password
  # and ignore the API key entirely, so this lane prompts, and in a
  # non-interactive shell it does not prompt so much as fail.
  #
  # Run it by hand, from a terminal, when the label in App Store Connect needs
  # to change. It is not part of any release and nothing calls it
  # automatically. Refrain collects nothing, so the label is DATA_NOT_COLLECTED
  # and changes about as often as that fact does.
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: APP_ID,
      json_path: "fastlane/privacy_details.json",
    )
  end

  desc "One-time: fill the privacy questionnaire in App Store Connect, then run this to capture the exact enum JSON as a reusable template"
  #
  # Same Apple ID sign-in as the privacy lane above, for the same reason: the
  # download action has no api_key parameter and no token path.
  lane :refresh_privacy_template do
    download_app_privacy_details_from_app_store(
      app_identifier: APP_ID,
      output_json_path: "fastlane/privacy_details.json",
    )
  end
end

# Where the Play service-account JSON lives.
#
# Its own method because two callers need the same answer: the version-code
# lookup and the upload that follows it, and a lookup pointed at a different
# account than the upload would report a version code that is not there.
def play_json_key
  ENV["SUPPLY_JSON_KEY"] || "pc-api-key.json"
end

# What supply is told to push, minus the version code, which the lane looks up.
#
# A hash from a plain method rather than a second lane, matching
# asc_key_options above: keeping the settings in one place is how they stay
# consistent with each other.
def play_listing_options
  {
    package_name: APP_ID,
    json_key: play_json_key,
    metadata_path: "fastlane/metadata/android",
    track: "production",
    skip_upload_aab: true,             # binary comes from EAS
    skip_upload_apk: true,
    skip_upload_changelogs: false,
    validate_only: false,
  }
end

# ---------------------------------------------------------------------------
platform :android do
  desc "Upload Google Play listing: metadata, screenshots, and feature graphic"
  #
  # The track is hardcoded to production, and stays that way. Unlike the EAS
  # submit config in eas.json -- which is lane-dependent, because the binary
  # really does go to a different track for internal testers -- this lane pushes
  # the *public* store listing, and the deploy script only ever calls it on the
  # store lane (see tools/ps/Deploy.ps1). The fast lane never reaches here:
  # pushing public listing copy from a tester build would publish changes nobody
  # asked to publish. So production is the only track this lane has any business
  # writing to.
  #
  # WHY THE VERSION CODE IS LOOKED UP, when this lane uploads no binary.
  #
  # supply hangs the whole listing off a release on the track rather than off
  # the app, so it needs to know which release. It normally learns that from
  # the binary it just uploaded, and this lane uploads none, so it has to be
  # told. Two separate failures come out of not telling it:
  #
  #   Could not find release for version code '' to update changelog
  #   Cannot find changelog because no version code given
  #
  # The first is the metadata, images and screenshots; the second is the
  # changelogs. skip_upload_changelogs guards neither of them, and an earlier
  # version of this lane retried without changelogs on the strength of that
  # guess. It failed identically.
  #
  # So the lane reads the track first and passes the highest code it finds.
  # That is always the release EAS most recently put there, which is the
  # release this listing belongs to. Hardcoding it would go stale on the next
  # build.
  lane :listing do
    version_codes = google_play_track_version_codes(
      package_name: APP_ID,
      json_key: play_json_key,
      track: "production",
    )

    # Checked before anything is uploaded rather than after. Half a listing on
    # the store and an error at the end is a worse place to stop than not
    # starting, and this is the one precondition the lane can see up front.
    if version_codes.empty?
      UI.error("The Play listing cannot be pushed yet: the production track has no release.")
      UI.error("")
      UI.error("supply attaches the listing to a release, so a build has to land on the track")
      UI.error("before any of it can go up. Skipping changelogs does not help.")
      UI.error("")
      UI.error("On an app that has never been published, Google accepts only draft releases,")
      UI.error("so the first build goes up with the 'production-draft' submit profile in")
      UI.error("eas.json. Once it is on the track, run this lane again.")
      UI.user_error!("No release on the production track.")
    end

    version_code = version_codes.max
    UI.message("Attaching the listing to version code #{version_code} on the production track.")

    upload_to_play_store(play_listing_options.merge(version_code: version_code))
  end
end
